# ---------------------------------------------------------------------------
# Pulso Comercial — variables de entorno
# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase.
# .env.local NO se sube al repo.
# ---------------------------------------------------------------------------

# Supabase -> Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pega-aqui-la-anon-key

# Secreto de administracion (Project Settings -> API -> service_role).
# SOLO servidor. Nunca lo publiques ni lo pongas en una variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-key

# Simbolo de moneda para la interfaz.
NEXT_PUBLIC_MONEDA_SIMBOLO=$

# ---------------------------------------------------------------------------
# Solo para `npm run seed` (crear el primer Administrador).
# No hace falta configurarlas en Vercel.
# ---------------------------------------------------------------------------
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-clave-min-8
